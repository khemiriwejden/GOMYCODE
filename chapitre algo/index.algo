



ALGORITHM 
VAR
 x:CHAR;
  
BEGIN
write("entrer le charactere x")
read(x)


IF (x in  "0123456789" ) THEN
    write( "numerique")
    ELSE_IF (x in "ABCDEFGHIJKLMNOPQRSTUVWXYZ") THEN
    write( "ALPHABETIC MAJUSCULE")
    ELSE_IF (x in "abcdefghijklmnopqrstuvwxyz") THEN

    write( "alphabetic miniscule")
   
    ELSE
    write( "special")


END_IF
END

ALGORITHM season
VAR
    n:INTEGER
